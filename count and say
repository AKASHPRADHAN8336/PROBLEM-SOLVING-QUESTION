class Solution {


    public String helper(int n){

        if(n==1) return "1";


        String s=helper(n-1);


        int l=s.length();


        int i=0;
        StringBuilder sb = new StringBuilder();
        int cnt=0;
        char ch=s.charAt(0);
        while(i<l){
            if(s.charAt(i) == ch) cnt++;
            else{
                sb.append(cnt);
                sb.append(ch);
                cnt=1;
                ch=s.charAt(i);
            }
            i++;
        }

        sb.append(cnt);
        sb.append(ch);

        return sb.toString();

        
    }
    public String countAndSay(int n) {

        return helper(n);
        
    }
}
