class Solution {
    public boolean isAnagram(String s1, String s2) {

        int[] arr = new int[26];
        int n1=s1.length();
        int n2=s2.length();

        if(n1!=n2) return false;


        for(int i=0;i<n1;i++){
            char ch = s1.charAt(i);

            arr[ch-'a']=arr[ch-'a']+1;
        }


        for(int i=0;i<n2;i++){

            char ch =s2.charAt(i);

            arr[ch-'a']=arr[ch-'a']-1;

        }

        for(int i=0;i<25;i++){
            if(arr[i]>0 || arr[i] !=0) return false;
        }
        return true;




