class Solution {
    
    public static boolean valid(int[] arr,int barrier,int k){
        int student=1;
        int page=0;
        
        for(int i=0;i<arr.length;i++){
            if(arr[i]>barrier) return false;
            
            if(page+arr[i] > barrier){
                student+=1;
                page=arr[i];
            }else{
                page+=arr[i];
            }
        }
        if(student>k){
            return false;
        }else{
            return true;
        }
    }
    public static int findPages(int[] arr, int k) {
        
        // code here
        int low=Arrays.stream(arr).min().getAsInt();
        int high=Arrays.stream(arr).sum();
        int ans=-1;
        if(k>arr.length) return ans;
        
        while(low<=high){
            int mid=(low+high)/2;
            
            if(valid(arr,mid,k)){
                high=mid-1;
                ans=mid;
            }else{
                low=mid+1;
            }
        }
        return ans;
    }
}
