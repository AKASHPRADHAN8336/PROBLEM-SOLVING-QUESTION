class Solution {
    Node constructDLL(int arr[]) {
        // Code here
        if(arr.length == 0 || arr == null){
            return null;
        }
        Node head = new Node(arr[0]);
        Node current=head;
        for(int i=1;i<arr.length;i++){
            Node newNode = new Node(arr[i]);
            current.next=newNode;
            newNode.prev=current;
            current=newNode;
        }
        
        return head;
        
    }
}
