
class Solution {

    public boolean helper(int[] arr,int ind, int target,int[][] dp){
        if(ind == 0) return (target == arr[0]);
        if(target == 0) return true;
        if(dp[ind][target] !=-1){
            return dp[ind][target]!=0?false:true;
        }
        boolean take=false;
        if(arr[ind]<target) take=helper(arr,ind-1,target-arr[ind],dp);
        boolean notTake=helper(arr,ind-1,target,dp);
        dp[ind][target]=take || notTake ? 1:0;
        return take||notTake;
    }    
    public boolean canPartition(int[] nums) {
        int target=0;
        int n=nums.length;
        if(n==1 || n==0) return false;
        for(int a:nums){
            target+=a;
        }
        if(target%2!=0) return false;
        // int[][] dp = new int[n][target/2+1];
        // for(int[] a:dp) Arrays.fill(a,-1);
        // return helper(nums,n-1,target/2,dp);

        boolean[][] dp = new boolean[n][target/2+1];

        for(int i=0;i<n;i++){
            dp[i][0]=true;
        }
        target=target/2;

        for(int i=1;i<n;i++){
            for(int t = 1;t<=target;t++){
                boolean take=false;
                if(nums[i]<=t) take=dp[i-1][t-nums[i]];
                boolean notTake=dp[i-1][t];

                dp[i][t] = take || notTake;
            }
        }

        return dp[n-1][target];
    }
}
