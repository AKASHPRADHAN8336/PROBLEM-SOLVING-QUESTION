class Solution {
    public int kthElement(int a[], int b[], int k) {
        // code here
        int i=0;
        int j=0;
        int ele=-1;
        int n1=a.length;
        int n2=b.length;
        int cnt=1;
        
        while(i<n1 && j<n2){
            if(a[i]<b[j]){
                if(cnt == k) return a[i];
                cnt++;
                i++;
            }else{
                if(cnt == k) return b[j];
                cnt++;
                j++;
            }
        }
        while(i<n1){
             if(cnt == k) return a[i];
                cnt++;
                i++;
        }
        
        while(j<n2){
            if(cnt == k) return b[j];
                cnt++;
                j++;
        }
        
        return -1;
    }
}
