class Solution {


    class pair{
        int r;
        int c;
        int time;


        public pair(int r,int c,int time){
            this.r=r;
            this.c=c;
            this.time=time;
        }

    }
    public int orangesRotting(int[][] grid) {

        int n=grid.length;
        int m=grid[0].length;

        boolean[][] vis=new boolean[n][m];
        
        int[] delrow={-1,0,1,0};
        int[] delcol={0,1,0,-1};

        Queue<pair> q=new LinkedList<>();

        for(int i=0;i<n;i++){
            for(int j=0;j<m;j++){
                if(grid[i][j] == 2) q.add(new pair(i,j,0));
            }
        }
        int t=0;
        while(!q.isEmpty()){
            pair ele=q.remove();
            int i=ele.r;
            int j=ele.c;
            t=ele.time;
            vis[i][j]=true;
            for(int k=0;k<4;k++){
                int delr=delrow[k]+i;
                int delc=delcol[k]+j;
                if(delr>=0 && delc>=0 && delr<n && delc<m &&grid[delr][delc]==1&& vis[delr][delc]==false){
                    vis[delr][delc]=true;
                    q.add(new pair(delr,delc,t+1));
                    grid[delr][delc]=2;
                }
            }
        }

        for(int i=0;i<n;i++){
            for(int j=0;j<m;j++){
                if(grid[i][j] == 1) return -1;
            }
        }

        return t;



        
    }
}
