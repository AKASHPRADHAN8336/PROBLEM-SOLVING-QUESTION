package ARRAY;

import java.util.Arrays;

public class SortZeros {
    public static void main(String[] args) {
        int[] arr = {0,1,1,4,0,0,5,6,0,0,3};


        
    int end = arr.length - 1;
        int start = end;

        if (end <= 1) {
            System.out.println("It is already sorted");
            return;
        }

        while (start >= 0) {
            if (arr[start] != 0) {
                arr[end] = arr[start];
                end--;
            }
            start--;
        }

         while (end >= 0) {
            arr[end] = 0;
            end--;
        }

        System.out.println(Arrays.toString(arr));

    }
}
