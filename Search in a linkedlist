/* Node of a linked list
  class Node {
   int data;
    Node next;
    Node(int d)  { data = d;  next = null; }
}
*/
class Solution {
    static boolean searchKey(int n, Node head, int key) {
        if(head == null) return false;
        if(head.data == key) return true;
        while(head.next!=null){
            if(head.data == key) return true;
            else head=head.next;
        }
        return false;
    }
}
