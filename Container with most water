class Solution {
    public int maxArea(int[] height) {
        
        int i=0;
        int j=height.length-1;
        int max=0;

        while(i<j){
            int maxleft=height[i];
        int maxright=height[j];

        int min=Math.min(maxleft,maxright);
        max= Math.max(max,min*(j-i));
        if(maxleft<maxright){
            i++;
        }
        else{
            j--;
        }

        }
        return max;
        
    }
}
