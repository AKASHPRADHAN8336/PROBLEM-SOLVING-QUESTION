class Solution {

    public String common(String str1 , String str2){
        int n=Math.min(str1.length(),str2.length());
        StringBuilder res = new StringBuilder();
        for(int i=0;i<n;i++){
            if(str1.charAt(i) == str2.charAt(i)){
                res.append(str1.charAt(i));
            }
            else{
                break;
            }
        }
        return res.toString();
    }
