class Solution {
    public String reverseWords(String s) {

        String[] ch = s.trim().split("\\s+");

        System.out.println(Arrays.toString(ch));

        StringBuilder str = new StringBuilder();

        for(int i=ch.length-1;i>=0;i--){


            System.out.println(i);

            str.append(ch[i]);
            if(i!=0) str.append(" ");

        }
        

        return str.toString();
    }
}
