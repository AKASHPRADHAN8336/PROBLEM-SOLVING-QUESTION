class Solution {

    public int maxConsecutive(int[] nums,int k){
        int maxLen=Integer.MIN_VALUE;
        int l=0;
        int r=0;
        int zero=0;

        while(r<nums.length){
            if(nums[r] == 0){
                zero++;
            }
            if(zero>k){
                if(nums[l] == 0){
                    zero--;
                }
                l++;
            }
            if(zero<=k){
                int len = r-l+1;
                maxLen=Math.max(maxLen,len);
            }
            r++;
        }
        return maxLen;

    }
