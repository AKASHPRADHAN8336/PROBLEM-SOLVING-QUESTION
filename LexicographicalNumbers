class Solution {


    public void helper(List<Integer> ans , int n , int idx){
        if(idx>n) return;
        ans.add(idx);


        for(int i=0;i<=9;i++){
            int num=(idx*10)+i;
            if(num>n) return;
            helper(ans,n,num);
            
        }
    }



    public List<Integer> lexicalOrder(int n) {

        List<Integer> ans = new ArrayList<>();

        for(int i=1;i<=9;i++){

            helper(ans,n,i);

        }


        return ans;
        
    }
}
