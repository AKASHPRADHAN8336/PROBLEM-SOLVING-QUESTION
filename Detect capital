class Solution {
    public boolean detectCapitalUse(String word) {

        boolean firstletter=false;
        if(Character.isUpperCase(word.charAt(0))) firstletter=true;
        int cap=0;
        int n=word.length();
        for(int i=0;i<word.length();i++){
            if(Character.isUpperCase(word.charAt(i))) cap++;
        }

        if(firstletter==true && cap == n) return true;
        else if(firstletter == true && cap == 1) return true;
        else if(firstletter == false && cap == 0) return true;
        else return false;
        
    }
}
