class Solution {


    public void helper(int[] nums,int target,int start,int end,int[] ans){
        if(end<start) return;
        int mid=start+(end-start)/2;

        if(target == nums[mid]){
            if(ans[0]==-1 || mid<ans[0]) ans[0]=mid;
            if(ans[1]==-1 || ans[1]<mid) ans[1]=mid;

            helper(nums,target,start,mid-1,ans);
            helper(nums,target,mid+1,end,ans);

        }else if(target>nums[mid]){
            helper(nums,target,mid+1,end,ans);
        }else{
            helper(nums,target,start,mid-1,ans);
        }
    }
    public int[] searchRange(int[] nums, int target) {

        int[] ans = new int[]{-1,-1};
        helper(nums,target,0,nums.length-1,ans);

        return ans;
        
    }
}
