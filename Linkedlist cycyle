/**
 * Definition for singly-linked list.
 * class ListNode {
 *     int val;
 *     ListNode next;
 *     ListNode(int x) {
 *         val = x;
 *         next = null;
 *     }
 * }
 */
public class Solution {
    public boolean hasCycle(ListNode head) {

        ListNode curr=head;
        ListNode prev=head;

        if(head == null) return false;
        while(curr!=null &&prev!=null&& prev.next!=null ){
            curr=curr.next;
            prev=prev.next.next;
            if(curr==prev) return true;
        }
      
        return false;
    }
}
