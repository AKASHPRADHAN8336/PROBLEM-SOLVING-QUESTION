class Solution {
    // Function to count nodes of a linked list.
    public int getCount(Node head) {
        int cnt=1;
        if(head.next == null){
            return cnt;
        }
        else{
            while(head.next!=null){
                head=head.next;
                cnt++;
            }
        }
        return cnt;
    }
}
