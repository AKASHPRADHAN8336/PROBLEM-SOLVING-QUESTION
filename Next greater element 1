     public int[] greaterElement(int[] nums1, int[] nums2) {
        int[] ans = new int[nums1.length];
        Arrays.fill(ans, -1);
        HashMap<Integer, Integer> map = new HashMap<>();

        for (int i = 0; i < nums2.length; i++) {
            map.put(nums2[i], i);
        }

        for (int i = 0; i < nums1.length; i++) {
            int idx = map.get(nums1[i]);

            while (idx < nums2.length && nums1[i] >= nums2[idx]) {
                idx++;
            }
            if (idx < nums2.length && nums1[i] < nums2[idx]) {
                ans[i] = nums2[idx];
            }
        }

        return ans;
    }




    public int[] helper(int[] num1,int[] num2){
        Stack<Integer> stack = new Stack<>();


        int n1=num1.length;
        int n2=num2.length;


        int[] newArr=  new int[10001];


        for(int i=n2-1;i>=0;i--){
            int target=num2[i];
            int j=n2;

            while(!stack.isEmpty() &&stack.peek()<=num2[i]){
                stack.pop();
            }
            if(stack.isEmpty()){
                newArr[num2[i]]=-1;
            }else{
                newArr[num2[i]]=stack.peek();
            }
            
            stack.push(num2[i]);
        }

        for(int i=0;i<num1.length;i++){
            num1[i]=newArr[num1[i]];
        }
        return num1;
    }
