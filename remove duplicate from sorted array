class Solution {
    public int removeDuplicates(int[] nums) {
         //  Stack<Integer> stack = new Stack<>();
        
        // stack.add(nums[0]);

        // for (int i = 1; i < nums.length; i++) {

        //     if (stack.peek() != nums[i]) {
        //         stack.add(nums[i]);
        //     }

        // }
        // int temp=stack.size();
        // for (int j = stack.size() - 1; j >= 0; j--) {
        //     nums[j] = stack.pop();
        // }
        // return temp;

        int k=1;
        Stack<Integer> stack = new Stack<>();
        stack.add(nums[0]);
        for(int i=1;i<nums.length;i++){
            if(stack.peek()!=nums[i]){
                stack.add(nums[i]);
                nums[k]=nums[i];
                k++;
            }
        }
        return stack.size();
    }
}
