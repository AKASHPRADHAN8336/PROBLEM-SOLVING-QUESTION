class Solution {
    public boolean isAnagram(String s1, String s2) {

         if(s1.length()!=s2.length()) return false;

        int[] character = new int[28];


        for(int i =0;i<s2.length();i++) character[s2.charAt(i)-'a']++;



        for(int i=0;i<s1.length();i++){
            char ch = s1.charAt(i);
            if(character[ch-'a']<=0) return false;
            character[ch-'a']--;
        }

        return true;


        
    }
}
