public class Solution {
    // you need treat n as an unsigned value
    public int reverseBits(int n) {

        int ans=0;
        for(int i=0;i<32;i++){
            int last=(n&1);
            int temp=last<<(31-i);
            ans=temp|ans;
            n=n>>1;
        }
        return ans;
        
    }
}
