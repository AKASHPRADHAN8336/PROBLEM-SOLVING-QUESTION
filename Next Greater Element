class Solution {
    public ArrayList<Integer> nextLargerElement(int[] arr) {
        // code here
        int n=arr.length;
        Stack<Integer> stack = new Stack();
        ArrayList<Integer> ans = new ArrayList<>();
        
        for(int i=n-1;i>=0;i--){
            
            while(!stack.isEmpty() && arr[i]>=stack.peek()){
                stack.pop();
            }
            
            if(stack.isEmpty()){
                ans.add(-1);
            }else{
                ans.add(stack.peek());
            }
            
            
            stack.push(arr[i]);
        }
        Collections.reverse(ans);
        
        return ans;
    }
}
