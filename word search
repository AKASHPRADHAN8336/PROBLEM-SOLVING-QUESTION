class Solution {


    public static boolean searchWord(char[][] grid, int i, int j, boolean[][] visited, String word, int idx) {
        if (idx == word.length() - 1) {
            return true;
        }

        visited[i][j] = true;

        if (i > 0 && visited[i - 1][j] == false && word.charAt(idx + 1) == grid[i - 1][j]
                && searchWord(grid, i - 1, j, visited, word, idx + 1)) {
            return true;
        }
        if (j > 0 && visited[i][j - 1] == false && word.charAt(idx + 1) == grid[i][j - 1]
                && searchWord(grid, i, j - 1, visited, word, idx + 1)) {
            return true;
        }
        if (i < grid.length - 1 && visited[i + 1][j] == false && word.charAt(idx + 1) == grid[i + 1][j]
                && searchWord(grid, i + 1, j, visited, word, idx + 1)) {
            return true;
        }
        if (j < grid[0].length - 1 && visited[i][j + 1] == false && word.charAt(idx + 1) == grid[i][j + 1]
                && searchWord(grid, i, j + 1, visited, word, idx + 1)) {
            return true;
        }

        visited[i][j] = false;

        return false;
    }
   
    
     public boolean exist(char[][] grid, String word) {
         boolean[][] visited = new boolean[grid.length][grid[0].length];

         for (int i = 0; i < grid.length; i++) {
            for (int j = 0; j < grid[0].length; j++) {
                if (word.charAt(0) == grid[i][j] && searchWord(grid, i, j, visited, word, 0)) {
                    return true;
                   
                }

            }
        }
        return false;
        
    }
}
