class Solution {

    public void permutation(int[] arr,List<List<Integer>> outer,List<Integer> internal){
        if(arr.length == 0){
           
            outer.add(new ArrayList<>(internal));
            return;
        }

        for(int i=0;i<arr.length;i++){
            internal.add(arr[i]);
            permutation(Arrays.copyOfRange(arr,1,arr.length),outer,internal);
            internal.remove(internal.size()-1);
        }

    
    }
    public List<List<Integer>> permute(int[] nums) {

        List<List<Integer>> outer = new ArrayList<>();
        List<Integer> internal = new ArrayList<>();
        boolean[] freq = new boolean[nums.length];
        // permutation(nums,outer,internal);
        permutation(nums,outer,internal,freq);
        return outer;
        
    }



    public void permutation(int[] nums,List<List<Integer>> outer,List<Integer> internal,boolean[] freq){
        if(nums.length == internal.size()){
            outer.add(new ArrayList<>(internal));
            return;
        }

        for(int i=0;i<nums.length;i++){
            if(!freq[i]){
                freq[i]=true;
                internal.add(nums[i]);
                permutation(nums,outer,internal,freq);
                freq[i]=false;
                internal.remove(internal.size()-1);
            }
        }
    }
}
