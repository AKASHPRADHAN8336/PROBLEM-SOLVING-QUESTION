class Solution {
    
    public int helper(int arr[][] , int days , int last,int[][] dp){
        if(days == 0){
            int max=0;
            for(int i=0;i<3;i++){
                if(i!=last){
                    max = Math.max(max,arr[0][i]);
                }
            }
            return max;
        }
        
        if(dp[days][last+1] !=-1) return dp[days][last+1];
        
        int max = 0;
        for(int i=0;i<3;i++){
            if(last!=i){
                int points = helper(arr,days-1,i,dp) + arr[days][i];
                
                max=Math.max(max,points);
            }
        }
        
        return dp[days][last+1]=max;
    }
    
    
    
    public int maximumPoints(int arr[][]) {
        // code here
        int n=arr.length;
        int[][] dp = new int[n][4];
        for (int i = 0; i < n; i++) {
            for (int j = 0; j < 4; j++) {
                dp[i][j] = -1;
            }
        }
        
        return helper(arr,n-1,-1,dp);
        
    }
}
