class Solution {

    public void helper(int[] nums,int idx,List<List<Integer>> ans,List<Integer> arr,boolean[] used){
        if(idx<0){
            ans.add(new ArrayList<>(arr));
            return;
        }

        for(int i=0;i<nums.length;i++){
            if(!used[i]){
                arr.add(nums[i]);
                used[i]=true;
                helper(nums,idx-1,ans,arr,used);

                arr.remove(arr.size()-1);
                used[i]=false;
            }
        }
        
    }
    public List<List<Integer>> permute(int[] nums) {

        List<List<Integer>> ans = new ArrayList<>();
        List<Integer> arr= new ArrayList<>();
        int n=nums.length-1;


        boolean[] used = new boolean[n+1];


        helper(nums,n,ans,arr,used);

        return ans;
    }
}
