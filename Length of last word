class Solution {
    public int lengthOfLastWord(String s) {

        s=s.trim();

        // char[] str=s.toCharArray();

        

        // System.out.println(s.length());

        int cnt=0;
        for(int i=s.length()-1;i>=0;i--){
            
            if(s.charAt(i)==' ') break;
            
            cnt++;

        }
        return cnt;
        
    }
}
