class Solution {

     private void fillrow(int[][] matrix,int r){
            for(int i=0;i<matrix[r].length;i++){
                matrix[r][i]=0;
            }
          
        }

           private void fillcol(int[][] matrix,int c){
            for(int i=0;i<matrix.length;i++){
                matrix[i][c]=0;
            }
          
        }
    public void setZeroes(int[][] matrix) {

        int r=matrix.length;
        int c=matrix[0].length;
        boolean[][] newArr = new boolean[r][c];
        for(int i=0;i<r;i++){
            for(int j=0;j<c;j++){
                if(matrix[i][j] == 0) newArr[i][j] = true;
            }  
        }
        for(int i=0;i<r;i++){
            for(int j=0;j<c;j++){
                if(newArr[i][j] == true) {
                    fillrow(matrix,i);
                    fillcol(matrix,j);
                }
            }
        }
        
    }
}
