class Solution {
    
    public static Boolean helper(int[] arr,int target,int ind,int[][] dp) {
        if(target == 0) return true;
        if(ind == 0) return(target == arr[0]);
        if(dp[ind][target]!=-1) return (dp[ind][target]==1); 
        
        
        boolean take=false;
        if(target>=arr[ind]){
            take=helper(arr,target-arr[ind],ind-1,dp);
        }
        boolean notTake=helper(arr,target,ind-1,dp);
        
        
         dp[ind][target] = (take || notTake) ? 1 : 0;
        return take || notTake;
    } 

    static Boolean isSubsetSum(int arr[], int sum) {
        
        // int[][] dp = new int[arr.length][sum+1];
        // for(int[] a:dp) Arrays.fill(a,-1);
        // code here
        // return helper(arr,sum,arr.length-1,dp);
        int n=arr.length;
        
        boolean[][] dp=new boolean[arr.length][sum+1];
        for(int i=0;i<n;i++) dp[i][0]=true;
        if (arr[0] <= sum) dp[0][arr[0]] = true;
        for(int ind=1;ind<n;ind++){
            for(int target=1;target<=sum;target++){
                boolean take=false;
                if(target>=arr[ind]){
                    take=dp[ind-1][target-arr[ind]];
                    
                }
                    boolean notTake=dp[ind-1][target];
                    dp[ind][target] =take || notTake;
            }
        }
        
        return dp[n-1][sum];
    }
}
