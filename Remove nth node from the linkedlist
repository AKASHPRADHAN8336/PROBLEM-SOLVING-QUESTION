    public ListNode helper(ListNode head,int k){
        if(head== null) return null;
        if(head.next==null && k==1) return null;
        ListNode dummy=new ListNode(-1);
        dummy.next=head;
        ListNode prev=dummy;
        ListNode curr = head;
        int n=0;
        while(curr!=null){
            n++;
            curr=curr.next;
        }
        int temp=n-k;
        int b=0;
        ListNode start=head;
        while(start!=null && b<temp ){
            b++;
            prev=prev.next;
            start=start.next;
        }
        prev.next=prev.next.next;
        return dummy.next;
    }
