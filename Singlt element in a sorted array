class Solution {
    public int singleNonDuplicate(int[] arr) {
        int high =arr.length-2;
        int low=0;

        while(low<=high){
            int mid=(low+high)/2;
            if(mid%2 == 1 && arr[mid]==arr[mid-1] || mid%2==0 && arr[mid]==arr[mid+1]){
                low=mid+1;
            }else{
                high=mid-1;
            }
        }
        return arr[low];
    }
}
